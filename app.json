{
  "expo": {
    "name": "expense-split",
    "slug": "expense-split",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensesplit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.neill.expensesplit",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1E0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF8A1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Expense Split to attach receipt photos to expenses.",
          "cameraPermission": "Allow Expense Split to photograph receipts.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Expense Split to unlock your expense records."
        }
      ],
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
